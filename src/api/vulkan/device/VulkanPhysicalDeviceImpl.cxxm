export module c_eng.api.vk:physical_device_impl;

import :core;
import :instance;
import :physical_device;
import :queue;

import c_eng.generic;

import cds;

using cds::experimental::Unexpected;

using vk::nullHandle;
using vk::enumeratePhysicalDevices;
using vk::enumeratePhysicalDeviceExtensionProperties;
using vk::getPhysicalDeviceFeatures;
using vk::getPhysicalDeviceProperties;
using vk::getPhysicalDeviceQueueFamilyProperties;

using c_eng::generic::indexedProject;
using c_eng::generic::forEach;

namespace c_eng::api::vk {
auto PhysicalDevice::extensionProperties() const noexcept -> Expected<Vector<ExtensionProperties>, Result> {
  Vector<ExtensionProperties> extensionProperties;
  U32 extensionCount = 0;
  if (auto result = enumeratePhysicalDeviceExtensionProperties(
          handle(), nullptr, &extensionCount, nullptr
      ); result != VK_SUCCESS) {
    return Unexpected{result};
  }
  extensionProperties.resize(extensionCount);
  if (auto result = enumeratePhysicalDeviceExtensionProperties(
          handle(), nullptr, &extensionCount, extensionProperties.data()
      ); result != VK_SUCCESS) {
    return Unexpected{result};
  }
  return extensionProperties;
}

auto PhysicalDevice::properties() const noexcept -> PhysicalDeviceProperties {
  PhysicalDeviceProperties properties {};
  getPhysicalDeviceProperties(handle(), &properties);
  return properties;
}

auto PhysicalDevice::features() const noexcept -> PhysicalDeviceFeatures {
  PhysicalDeviceFeatures features {};
  getPhysicalDeviceFeatures(handle(), &features);
  return features;
}

auto PhysicalDevice::queueFamilies() const noexcept -> Vector<QueueFamily> {
  Vector<QueueFamilyProperties> properties;
  U32 propertyCount = 0;
  getPhysicalDeviceQueueFamilyProperties(handle(), &propertyCount, nullptr);
  properties.resize(propertyCount);
  getPhysicalDeviceQueueFamilyProperties(handle(), &propertyCount, properties.data());
  return Vector<QueueFamily>{properties | indexedProject([this](U32 index, auto const& properties) {
    return QueueFamily{*this, index, properties};
  })};
}

[[nodiscard]] auto physicalDevices(Instance const& instance) noexcept -> Expected<Vector<PhysicalDevice>, Result> {
  Vector<PhysicalDeviceHandle> deviceHandles;
  U32 deviceCount = 0;
  if (auto result = enumeratePhysicalDevices(instance.handle(), &deviceCount, nullptr);
      result != VK_SUCCESS) {
    return Unexpected{result};
  }

  deviceHandles.resize(deviceCount);
  if (auto result = enumeratePhysicalDevices(instance.handle(), &deviceCount, deviceHandles.data());
      result != VK_SUCCESS) {
    return Unexpected{result};
  }

  return deviceHandles | project([](auto handle) { return PhysicalDevice{handle}; });
}
} // namespace c_eng::api::vk
