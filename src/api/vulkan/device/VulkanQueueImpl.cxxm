export module c_eng.api.vk:queue_impl;
import :core;
import :queue;
import :physical_device;
import :surface;
import cds;

using cds::experimental::Expected;
using cds::experimental::Unexpected;

using vk::Result;
using vk::getPhysicalDeviceSurfaceSupport;
using vk::vkFalse;
using vk::vkTrue;

namespace c_eng::api::vk {
auto QueueFamily::supportsPresentOn(Surface const& surface) const noexcept -> Expected<bool, Result> {
  Bool32 supported = vkFalse;
  if (auto result = getPhysicalDeviceSurfaceSupport(device().handle(), index(), surface.handle(), &supported);
      result != VK_SUCCESS) {
    return Unexpected{result};
  }
  return supported == vkTrue;
}
} // namespace c_eng::api::vk
