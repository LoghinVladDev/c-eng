module;
#include <algorithm>
#include <iostream>

export module c_eng.api.vk:logical_device_impl;
import :core;
import :logical_device;
import :physical_device;
import :queue;
import :surface;
import cds;
import c_eng.generic;

using cds::Tuple;
using cds::U32;
using cds::Vector;
using cds::experimental::Expected;
using cds::experimental::Unexpected;

using cds::makeTuple;

using c_eng::generic::forEach;
using c_eng::generic::project;

using vk::DeviceCreateInfo;
using vk::DeviceHandle;
using vk::DeviceQueueCreateInfo;
using vk::createDevice;
using vk::destroyDevice;

auto makeQueueFamilyConfig(auto const& queueConfig) noexcept {
  Vector<Tuple<U32, Vector<float>>> result;
  queueConfig | project([](auto const& config) -> Tuple<U32, Vector<float>> {
    return {config.key()->index(), config.value()};
  }) | forEach([&result](auto&& entry) { result.emplaceBack(mv(entry)); });
  std::sort(result.data(), result.data() + result.size(), [](auto const& a, auto const& b) {
    return get<0>(a) < get<0>(b);
  });
  return result;
}

auto emplaceInto(auto const& configs, Vector<DeviceQueueCreateInfo>& createInfos) {
  configs | forEach([&createInfos](auto const& config) {
    createInfos.pushBack({
        .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
        .pNext = nullptr,
        .flags = 0u,
        .queueFamilyIndex = get<0>(config),
        .queueCount = static_cast<U32>(get<1>(config).size()),
        .pQueuePriorities = get<1>(config).data()
    });
  });
}

namespace c_eng::api::vk {
auto createLogicalDevice(
    PhysicalDevice const& device,
    HashMap<QueueFamily const*, Vector<float>> const& queueConfig,
    Surface const& surface
) noexcept -> Expected<LogicalDevice, Result> {
  auto queueFamilyConfig = makeQueueFamilyConfig(queueConfig);
  Vector<DeviceQueueCreateInfo> queueCreateInfos;
  queueCreateInfos.reserve(queueFamilyConfig.size());
  emplaceInto(queueFamilyConfig, queueCreateInfos);

  Vector extensions {"VK_KHR_swapchain"};
  auto const deviceFeatures = device.features();

  DeviceCreateInfo createInfo {
      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
      .pNext = nullptr,
      .flags = 0u,
      .queueCreateInfoCount = static_cast<U32>(queueCreateInfos.size()),
      .pQueueCreateInfos = queueCreateInfos.data(),
      .enabledExtensionCount = static_cast<U32>(extensions.size()),
      .ppEnabledExtensionNames = extensions.data(),
      .pEnabledFeatures = &deviceFeatures
  };

  DeviceHandle deviceHandle;
  if (auto const result = createDevice(device.handle(), &createInfo, nullptr, &deviceHandle);
      result != VK_SUCCESS) {
    return Unexpected{result};
  }

  return LogicalDevice(deviceHandle);
}

LogicalDevice::~LogicalDevice() noexcept {
  destroyDevice(_handle, nullptr);
}
} // namespace c_eng::api::vk
