export module c_eng.api.vk:logical_device_factory;
import :core;
import :logical_device;
import :physical_device;
import :queue;
import :surface;
import cds;

using cds::HashMap;
using cds::Vector;
using cds::experimental::Unexpected;

using vk::Result;

export namespace c_eng::api::vk {
class PresentingLogicalDeviceFactory;

class LogicalDeviceFactory {
public:
  LogicalDeviceFactory() = default;
  LogicalDeviceFactory(LogicalDeviceFactory&&) = default;

  auto&& addQueueFrom(QueueFamily const& family, float priority)&& noexcept {
    _plannedQueues[&family].emplaceBack(priority);
    return mv(*this);
  }

  auto presentOn(Surface const& surface)&& noexcept -> PresentingLogicalDeviceFactory;

protected:
  [[nodiscard]] constexpr auto const& plannedQueues() const noexcept {
    return _plannedQueues;
  }

private:
  HashMap<QueueFamily const*, Vector<float>> _plannedQueues;
};

class PresentingLogicalDeviceFactory : protected LogicalDeviceFactory {
public:
  constexpr PresentingLogicalDeviceFactory(
      LogicalDeviceFactory&& subFactory, Surface const& surface
  ) noexcept : LogicalDeviceFactory{mv(subFactory)}, _surface{surface} {}

  [[nodiscard]] auto build(PhysicalDevice const& device) const noexcept -> Expected<LogicalDevice, Result>;

private:
  Surface const& _surface;
};

auto LogicalDeviceFactory::presentOn(Surface const& surface)&& noexcept -> PresentingLogicalDeviceFactory {
  return {mv(*this), surface};
}
} // namespace c_eng::api::vk
