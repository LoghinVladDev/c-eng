export module c_eng.api.vk:physical_device;
import cds;
import :core;
import :instance;
import :queue;

using cds::Vector;
using cds::experimental::Expected;

using vk::ExtensionProperties;
using vk::PhysicalDeviceFeatures;
using vk::PhysicalDeviceHandle;
using vk::PhysicalDeviceProperties;
using vk::PhysicalDeviceType;
using vk::QueueFamilyProperties;
using vk::Result;

export namespace c_eng::api::vk {
class PhysicalDevice {
public:
  using Type = PhysicalDeviceType;

  explicit constexpr PhysicalDevice(PhysicalDeviceHandle handle) noexcept : _handle{handle} {}
  PhysicalDevice(PhysicalDevice const& device) noexcept : _handle{device._handle} {}

  [[nodiscard]] auto extensionProperties() const noexcept -> Expected<Vector<ExtensionProperties>, Result>;
  [[nodiscard]] auto properties() const noexcept -> PhysicalDeviceProperties;
  [[nodiscard]] auto features() const noexcept -> PhysicalDeviceFeatures;
  [[nodiscard]] auto queueFamilies() const noexcept -> Vector<QueueFamily>;

  [[nodiscard]] constexpr auto handle() const noexcept -> PhysicalDeviceHandle {
    return _handle;
  }

private:
  PhysicalDeviceHandle _handle;
};

[[nodiscard]] auto physicalDevices(Instance const& instance) noexcept -> Expected<Vector<PhysicalDevice>, Result>;
} // namespace c_eng::api::vk
