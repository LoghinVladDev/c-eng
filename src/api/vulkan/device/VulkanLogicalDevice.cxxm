export module c_eng.api.vk:logical_device;
import :core;
import :physical_device;
import :queue;
import :surface;
import cds;

using cds::HashMap;
using cds::Vector;
using cds::experimental::Expected;
using cds::impl::xch;

using vk::DeviceHandle;
using vk::Result;
using vk::nullHandle;

export namespace c_eng::api::vk {
class LogicalDevice {
public:
  LogicalDevice() = delete;
  LogicalDevice(LogicalDevice const&) = delete;

  constexpr LogicalDevice(LogicalDevice&& obj) noexcept : _handle{xch(obj._handle, nullHandle)} {}
  explicit constexpr LogicalDevice(DeviceHandle handle) noexcept : _handle{handle} {}

  ~LogicalDevice() noexcept;

private:
  DeviceHandle _handle;
};

auto createLogicalDevice(
    PhysicalDevice const& device,
    HashMap<QueueFamily const*, Vector<float>> const& queueConfig,
    Surface const& surface
) noexcept -> Expected<LogicalDevice, Result>;
} // namespace c_eng::api::vk
